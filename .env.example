# Copy this file to .env and fill in your Supabase connection details.
# ingest.py loads .env automatically. Do NOT commit .env if you init git here.

# Easiest: paste the full connection string from
#   Supabase dashboard > Project Settings > Database > Connection string (URI).
# Prefer the "Session pooler" URI (works over IPv4). It already contains the password.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- OR provide the parts individually instead of SUPABASE_DB_URL ---
# SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres.<project-ref>
# SUPABASE_DB_PASSWORD=<password>
# SUPABASE_DB_SSLMODE=require

# --- Ollama (defaults shown; usually no need to change) ---
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=nomic-embed-text
# OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct   # only if JUDGE_BACKEND=ollama

# --- LLM backends (llm.py): generation = answer.py, judge = evals/score_run.py.
#     Each is independent: groq | gemini | ollama. Both default to groq.
#     Groq free key: https://console.groq.com/keys (free tier is tokens/min + daily
#     limited; run_evals and score_run pace, checkpoint, and resume automatically).
#     IMPORTANT: if generation and the judge use the SAME model, the judge grades
#     its own output (self-preference bias). Set a different JUDGE_MODEL (or
#     JUDGE_BACKEND) so the two differ.
GROQ_API_KEY=your-groq-api-key
# GEN_BACKEND=groq                     # generation backend (groq | gemini | ollama)
# GEN_MODEL=                           # override the backend default for generation
# JUDGE_BACKEND=groq                   # judge backend
# JUDGE_MODEL=                         # e.g. a different model, to avoid self-judging
# GROQ_MODEL=llama-3.3-70b-versatile   # default groq model when GEN_/JUDGE_MODEL unset

# --- Gemini (only if a backend above is set to 'gemini'). Free key: https://aistudio.google.com/apikey ---
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash
