# Copy this file to .env and fill in your Supabase connection details.
# ingest.py loads .env automatically. Do NOT commit .env if you init git here.

# Easiest: paste the full connection string from
#   Supabase dashboard > Project Settings > Database > Connection string (URI).
# Prefer the "Session pooler" URI (works over IPv4). It already contains the password.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- OR provide the parts individually instead of SUPABASE_DB_URL ---
# SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres.<project-ref>
# SUPABASE_DB_PASSWORD=<password>
# SUPABASE_DB_SSLMODE=require

# --- Ollama (defaults shown; usually no need to change) ---
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=nomic-embed-text
# OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct   # only if JUDGE_BACKEND=ollama

# --- LLM backends (llm.py): generation = answer.py, judge = evals/score_run.py.
#     Each is independent: groq | gemini | openrouter | ollama.
#     IMPORTANT: if generation and the judge use the SAME model, the judge grades
#     its own output (self-preference bias). Point GEN_MODEL and JUDGE_MODEL at
#     DIFFERENT models. The model is chosen per role, so one provider key can drive
#     two different models (e.g. two OpenRouter models under one OPENROUTER_API_KEY).
# GEN_BACKEND=openrouter                            # groq | gemini | openrouter | ollama
# GEN_MODEL=meta-llama/llama-3.3-70b-instruct       # override the backend default
# JUDGE_BACKEND=openrouter
# JUDGE_MODEL=openai/gpt-4o-mini                    # a DIFFERENT (non-Llama) model

# OpenRouter (pay-per-token; sidesteps free-tier daily caps). Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct   # default when GEN_/JUDGE_MODEL unset

# Groq (free tier: tokens/min + daily limited). Key: https://console.groq.com/keys
# GROQ_API_KEY=your-groq-api-key
# GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (only if a backend is set to 'gemini'). Key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash
